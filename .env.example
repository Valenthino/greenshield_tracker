# Generate a salted scrypt hash with npm run setup. Never commit plaintext passwords.
CRM_PASSWORD_HASH=
# Must be a persistent, writable server volume, not ephemeral container storage.
CRM_DATABASE_PATH=data/crm.json
# Exact external origin, without a trailing slash, for reverse-proxy CSRF validation.
# Example: https://crm-preview.your-domain.example
CRM_PUBLIC_ORIGIN=
# false only for local HTTP review; true for HTTPS-protected Coolify preview.
CRM_COOKIE_SECURE=false
