{
  "name": "green-shield-outreach-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run typecheck && npm run build",
    "start": "next start --hostname 127.0.0.1",
    "setup": "node scripts/setup.mjs",
    "start:container": "next start --hostname 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module"
}
